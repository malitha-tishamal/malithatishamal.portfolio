rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Firestore Security Rules — Malitha Tishamal Portfolio
//
// Model:
//   • Public content is readable by anyone (the site is public).
//   • ALL content writes/deletes require an APPROVED ADMIN.
//   • A few collections accept anonymous *create* only (contact inquiries,
//     newsletter signups, visitor analytics, live visitor counter). Anonymous
//     users can never read/update/delete those — only admins can.
//   • The `users` collection is private (own profile + admins only).
//
// Deploy:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Owner's super-admin email — guarantees you can never be locked out even
    // if your /users profile doc is missing or misconfigured. The address must
    // be verified: an unverified signup cannot claim it.
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'malithatishamal@gmail.com';
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          isSuperAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true
          )
        );
    }

    // The public content documents are world-readable, so they must never
    // contain mail credentials. Older builds stored the Gmail app password in
    // `siteContent/footer`; block any write that reintroduces those fields.
    function noSmtpSecrets() {
      return !request.resource.data.keys().hasAny([
        'gmailSmtpAppPassword',
        'gmailSmtpUser',
        'gmailNotificationRecipient',
        'gmailSmtpEnabled',
        'newsletterNotificationEmail'
      ]);
    }

    // ── Public content: world-readable, admin-writable ──────────────────────
    match /portfolio/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc}         { allow read: if true; allow write: if isAdmin(); }
    match /blogs/{doc}            { allow read: if true; allow write: if isAdmin(); }
    match /certifications/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /experiences/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /services/{doc}         { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /techCategories/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /techItems/{doc}        { allow read: if true; allow write: if isAdmin(); }

    // ── Site content (hero, footer, slider settings, categories, etc.) ──────
    // The live visitor counter is incremented by anonymous visitors, so it gets
    // a dedicated rule allowing public read + a validated +1 update.
    match /siteContent/visitorCounter {
      allow read: if true;
      // Anonymous visitors may only bump the counter by exactly one, and may
      // not touch any other field.
      allow update: if request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['totalVisitors', 'updatedAt'])
        && request.resource.data.totalVisitors == resource.data.totalVisitors + 1;
      // First-ever initialisation (fresh database) — value must start at 1.
      allow create: if request.resource.data.keys()
          .hasOnly(['totalVisitors', 'createdAt', 'updatedAt'])
        && request.resource.data.totalVisitors == 1;
      allow delete: if isAdmin();
    }
    match /siteContent/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() && noSmtpSecrets();
      allow delete: if isAdmin();
    }

    // ── Uploaded landing pages (published at /projects/{slug}/) ─────────────
    // The public route and the admin panel both read the manifest; only admins
    // can create/replace/remove it.
    match /landingPages/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Anonymous-create collections (public submit, admin-only manage) ─────
    // The contact form writes inquiries directly from the browser. Whitelist
    // the exact shape so the endpoint cannot be abused to plant arbitrary
    // fields (for example a forged `status` or oversized payload).
    match /inquiries/{doc} {
      allow create: if request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'country',
          'serviceCategory', 'message', 'status', 'isStarred', 'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.isStarred == false
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.firstName.size() <= 120
        && request.resource.data.lastName.size() <= 120
        && request.resource.data.country.size() <= 120;
      allow read, update, delete: if isAdmin();
    }
    match /newsletterSubscribers/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      allow read, update, delete: if isAdmin();
    }
    match /advancedAnalytics/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /visitors/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /techStackActivityLogs/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    // dailyStats is read publicly (to render counts) and written by the
    // anonymous visitor hook; deletion stays admin-only.
    match /dailyStats/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys()
          .hasOnly(['date', 'totalVisitors', 'uniqueVisitors', 'locations', 'createdAt', 'updatedAt'])
        && request.resource.data.totalVisitors is int
        && request.resource.data.uniqueVisitors is int;
      // Anonymous updates may only bump the counters / locations — never swap
      // the date or inject arbitrary fields.
      allow update: if request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['totalVisitors', 'uniqueVisitors', 'locations', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ── Users: private ──────────────────────────────────────────────────────
    match /users/{uid} {
      // A signed-in user may read their own profile; admins may read any.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Signup creates your own doc, forced to a non-privileged pending state
      // (unless you are the super admin). Blocks self-approval / role escalation.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (
          isSuperAdmin() ||
          (request.resource.data.status == 'pending'
            && request.resource.data.isApproved == false)
        );

      // Admins manage everyone; the super admin may update their own doc
      // (used by the auto-approve bootstrap in AuthContext).
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid && isSuperAdmin());

      allow delete: if isAdmin();
    }

    // ── Default deny: anything not explicitly listed above ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
