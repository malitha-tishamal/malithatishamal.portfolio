# Firebase Configuration
# Replace these values with your actual Firebase Project credentials from Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyForYourFirebaseApp12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Initial Super Admin Email (automatically approved as admin on first login)
NEXT_PUBLIC_INITIAL_ADMIN_EMAIL=admin@gmail.com
