# Firebase Configuration
# Replace these values with your actual Firebase Project credentials from Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyForYourFirebaseApp12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Initial Super Admin Email (automatically approved as admin on first login)
NEXT_PUBLIC_INITIAL_ADMIN_EMAIL=admin@gmail.com

# Server-side admin allow-list (comma separated, server only)
# API routes additionally require a verified Firebase email and an approved
# role/status profile in Firestore.
ADMIN_EMAILS=malithatishamal@gmail.com

# Server Encryption Key (32-byte hex for AES-256-GCM)
# Generate a fresh one and NEVER commit the real value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ── Email notifications (server only — never NEXT_PUBLIC_) ──────────────────
# Gmail requires a 16-character App Password (2-Step Verification must be on).
# These values must never be stored in Firestore: siteContent is world-readable.
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-char-google-app-password
CONTACT_RECEIVER_EMAIL=your-inbox@gmail.com

# Cloudinary Configuration (Media Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Cloudinary Admin API (server-side signed uploads + deleting ZIPs / landing files)
# Optional: without these, ZIPs upload unsigned and old files are not auto-deleted.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Project landing pages
# local  = files live on this server under LANDING_PAGE_STORAGE_DIR (dev / self-host)
# cloudinary = ZIPs and files upload to Cloudinary as raw assets (use on Vercel)
LANDING_PAGE_STORAGE=local
LANDING_PAGE_STORAGE_DIR=
LANDING_PAGE_STAGING_DIR=

# Public site origin (Back to Portfolio target + absolute links)
NEXT_PUBLIC_SITE_URL=https://malithatishamal.vercel.app

